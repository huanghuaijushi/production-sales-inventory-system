{
  "name": "production-sales-inventory-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode guanrui",
    "dev:wenhuizhai": "vite --host 0.0.0.0 --mode wenhuizhai",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run build:guanrui && npm run build:wenhuizhai",
    "build:guanrui": "vite build --mode guanrui",
    "build:wenhuizhai": "vite build --mode wenhuizhai",
    "preview": "vite preview --host 0.0.0.0 --mode guanrui"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
